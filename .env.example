# Copy to .env and fill in. Nothing here has a safe default.

# Postgres connection for the release.
DATABASE_URL=ecto://postgres:postgres@localhost/nerd_meet_prod

# Phoenix session and token signing. Generate with `mix phx.gen.secret`.
SECRET_KEY_BASE=

# Wraps every per-conversation data key. Generate with `mix nerd.gen.vault_key`.
#
# Losing this makes every stored message permanently unreadable. That is the
# intended behaviour of crypto-shredding and a very bad accident, so back it up
# somewhere separate from the database backups — keeping both in one place
# defeats the point of having them apart.
VAULT_MASTER_KEY=

# Public hostname, used for URL generation and the WebAuthn relying party id.
PHX_HOST=localhost
PORT=4000
PHX_SERVER=true
